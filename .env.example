# ==============================================================================
# TestBench Environment Configuration (.env)
# ==============================================================================
# All variables are OPTIONAL. TestBench automatically discovers executables
# from standard system paths (PATH, ANDROID_HOME, default SDK locations).
# Override any setting below to point to custom locations.

# --- Workspace Storage ---
# Custom directory path where uploaded projects, logs, and database are stored.
# Default: <testbench_root>/workspace
# TESTBENCH_WORKSPACE=C:\custom\testbench\workspace

# --- Android SDK & Emulators ---
# Base directory of the Android SDK installation.
# ANDROID_HOME=C:\Users\username\AppData\Local\Android\Sdk
# ANDROID_SDK_ROOT=C:\Users\username\AppData\Local\Android\Sdk

# Explicit executable paths (if not in PATH or standard SDK location):
# ADB_COMMAND=C:\platform-tools\adb.exe
# EMULATOR_COMMAND=C:\Android\Sdk\emulator\emulator.exe

# --- Test Frameworks & Runtimes ---
# MAVEN_COMMAND=mvn
# NODE_COMMAND=node
# NPX_COMMAND=npx
# APPIUM_COMMAND=npx appium
# PYTHON_COMMAND=python

# --- Video & Remote Screen Mirroring ---
# FFMPEG_COMMAND=ffmpeg
# SCRCPY_SERVER_PATH=C:\scrcpy\scrcpy-server.jar

# --- Server Host & Port ---
# HOST=127.0.0.1
# PORT=8000
