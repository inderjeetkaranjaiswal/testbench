# ==============================================================================
# TestBench Backend Environment Configuration (.env)
# ==============================================================================

# Custom workspace path (Default: <repo_root>/workspace)
# TESTBENCH_WORKSPACE=C:\custom\testbench\workspace

# Android SDK
# ANDROID_HOME=C:\Users\username\AppData\Local\Android\Sdk
# ANDROID_SDK_ROOT=C:\Users\username\AppData\Local\Android\Sdk
# ADB_COMMAND=adb
# EMULATOR_COMMAND=emulator

# Build & Test Tools
# MAVEN_COMMAND=mvn
# NODE_COMMAND=node
# NPX_COMMAND=npx
# APPIUM_COMMAND=npx appium

# Screen Streaming & FFmpeg
# FFMPEG_COMMAND=ffmpeg
# SCRCPY_SERVER_PATH=
